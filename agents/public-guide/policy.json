{
  "schemaVersion": 1,
  "profile": "public-guide",
  "allow": {
    "surfaces": ["stex", "rice", "openui"],
    "knowledge": "public-provenance-only",
    "streaming": true,
    "submissionHandoff": "external-worker-portal-only",
    "mode": "text-chat-only"
  },
  "deny": [
    "filesystem", "terminal", "browser", "code-execution", "memory",
    "delegation", "cron", "deployment", "secrets", "private-retrieval",
    "submission-file-access", "email-tool-access", "profile-selection",
    "model-selection", "system-prompt-selection"
  ],
  "limits": {
    "maxTurns": 4,
    "maxMessages": 12,
    "maxMessageCharacters": 1000,
    "requiresTurnstile": true,
    "requiresRateLimit": true
  }
}
