{
  "name": "stexpedite-press",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": ["apps/stex", "apps/backend", "apps/chat", "apps/admin", "packages/*"],
  "scripts": {
    "identity:build": "python scripts/generate-identity-assets.py",
    "sync:chat-client": "node scripts/sync-chat-client.mjs",
    "check:chat-client": "node scripts/sync-chat-client.mjs --check",
    "build": "npm run build:stex",
    "build:stex": "npm run sync:chat-client && npm --prefix apps/stex run build",
    "build:web": "npm run build:stex",
    "build:rice": "npm run sync:chat-client && cd apps/rice && python scripts/build_public_site.py",
    "build:chat": "npm --prefix apps/chat run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:all": "npm run build:stex && npm run build:rice && npm run build:chat && npm run build:admin",
    "dev:stex": "npm --prefix apps/stex run dev",
    "dev:web": "npm run dev:stex",
    "dev:rice": "cd apps/rice && python -m http.server 4173",
    "dev:chat": "npm --prefix apps/chat run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:worker": "npm run dev:backend",
    "run:bash": "node scripts/run-bash.mjs",
    "sync:backend-dev-vars": "node scripts/sync-backend-dev-vars.mjs",
    "sync:worker-dev-vars": "npm run sync:backend-dev-vars",
    "bootstrap:venv": "node scripts/run-bash.mjs scripts/bootstrap-python-venv.sh",
    "assets:sync": "node scripts/run-bash.mjs scripts/sync-assets.sh",
    "assets:check": "node scripts/run-bash.mjs scripts/check-assets-sync.sh",
    "lint:html": "npx -y htmlhint \"apps/stex/dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:rice": "cd apps/rice && python scripts/check_assets.py",
    "check:docs": "node scripts/check-docs-coverage.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:seo": "node scripts/run-bash.mjs scripts/check-site-seo.sh",
    "check:audit": "npm audit --audit-level=high",
    "runtime:config": "node scripts/run-bash.mjs scripts/check-runtime-config.sh",
    "runtime:audit": "node scripts/run-bash.mjs ops/cloudflare-stability/scripts/runtime-audit.sh",
    "smoke:api": "node scripts/run-bash.mjs ops/cloudflare-stability/scripts/smoke-api.sh",
    "smoke:api:full": "node scripts/run-bash.mjs ops/cloudflare-stability/scripts/smoke-api.sh --full",
    "release": "node scripts/run-bash.mjs scripts/release.sh",
    "release:dry-run": "node scripts/run-bash.mjs scripts/release.sh --dry-run",
    "release:log": "node scripts/run-bash.mjs ops/cloudflare-stability/scripts/log-release-evidence.sh",
    "test:backend": "npm --prefix apps/backend run test",
    "test:worker": "npm run test:backend",
    "test:chat-client": "npm --prefix packages/chat-client run test",
    "check": "npm run check:docs && npm run check:chat-client && npm run test:chat-client && npm run build:all && npm run lint:html && npm run check:links && npm run check:a11y && npm run test:backend && npm run check:audit",
    "deploy:stex": "node scripts/deploy-web.mjs",
    "deploy:web": "npm run deploy:stex",
    "deploy:rice": "npm run build:rice && npx wrangler pages deploy apps/rice/_site --project-name=rice-magazine --branch=main --commit-dirty=true",
    "deploy:chat": "npm run build:chat && npx wrangler pages deploy apps/chat/dist --project-name=stexpedite-chat --branch=main --commit-dirty=true",
    "deploy:admin": "npm run build:admin && npx wrangler pages deploy apps/admin/dist --project-name=stexpedite-admin --branch=main --commit-dirty=true",
    "deploy:all": "npm run deploy:stex && npm run deploy:rice",
    "deploy:backend": "npm --prefix apps/backend run deploy",
    "deploy:worker": "npm run deploy:backend"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.70"
  }
}
