---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Chat with St. Expedite Press, or submit a manuscript directly to the editor.">
  <meta name="chat-endpoint" content="https://stexpedite.press/api/chat">
  <meta name="chat-history-endpoint" content="https://stexpedite.press/api/chat/history">
  <meta name="submission-endpoint" content="https://stexpedite.press/api/submit">
  <meta name="updates-endpoint" content="https://stexpedite.press/api/updates">
  <meta name="api-base" content="https://stexpedite.press">
  <meta name="turnstile-sitekey" content="0x4AAAAAADc-GOYeYwVaZA_I">
  <title>Chat — St. Expedite Press</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
  <script src="chat-client.js" defer></script>
  <script src="app.js" defer></script>
  <script src="profiles-ui.js" defer></script>
</head>
<body>
  <a class="skip" href="#composer">Skip to message</a>
  <div class="shell">
    <aside class="rail" aria-label="Chat navigation">
      <a class="brand" href="https://stexpedite.press" aria-label="St. Expedite Press home">
        <span class="brand__seal">SE</span><span>PUBLIC CHAT</span>
      </a>
      <button class="new-chat" type="button" data-new-chat>+ New conversation</button>
      <button class="submission-button" type="button" data-open-submission>Submit work</button>
      <div class="session-transfer">
        <button class="new-chat" type="button" data-download-chat>Download conversation</button>
        <button class="new-chat" type="button" data-upload-chat>Upload conversation</button>
        <input type="file" accept="application/json" data-upload-input hidden>
      </div>
      <p class="session-transfer__note">Your own copy of this transcript &mdash; download it, or upload one to pick a conversation back up. Uploading never sends anything to us; it only redraws this page.</p>
      <nav aria-label="Chat mode">
        <p class="rail__label">Mode</p>
        <button class="surface is-active" type="button" data-surface="openui" aria-pressed="true">General chat</button>
        <button class="surface" type="button" data-surface="stex" aria-pressed="false">Ask about the press</button>
      </nav>

      <div class="presets" data-presets-block>
        <p class="rail__label">Assistant preset</p>
        <label class="sr-only" for="preset-select">Assistant preset</label>
        <select id="preset-select" data-preset-select>
          <option value="">Default (no preset)</option>
        </select>
        <div class="presets__auth" data-visitor-auth>
          <form data-visitor-login-form>
            <label class="sr-only" for="visitor-email">Email</label>
            <div class="updates-inline__row">
              <input id="visitor-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="320" placeholder="Sign in to build an assistant">
              <button type="submit" aria-label="Send sign-in link">&rarr;</button>
            </div>
          </form>
          <p class="presets__status" data-visitor-status aria-live="polite"></p>
        </div>
        <div class="presets__authed" data-visitor-authed hidden>
          <p class="rail__note" data-visitor-email></p>
          <button class="new-chat" type="button" data-open-preset-builder>Build an assistant</button>
          <button class="new-chat" type="button" data-visitor-logout>Sign out</button>
        </div>
      </div>

      <p class="rail__note">Submit work sends your manuscript straight to the editor; the chat never sees the file. The public assistant can also give you a human email address.</p>

      <form class="updates-inline" data-updates-form novalidate>
        <label class="rail__label" for="updates-email">Get updates on new releases</label>
        <div class="updates-inline__row">
          <input id="updates-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="320" placeholder="you@example.com">
          <input class="sr-only" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button type="submit" aria-label="Sign up for updates">&rarr;</button>
        </div>
        <p class="updates-inline__status" data-updates-status aria-live="polite"></p>
      </form>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <div><span class="eyebrow">ST. EXPEDITE / CHAT</span><h1 data-title>Start a conversation</h1></div>
        <span class="status-dot"><i></i> Public assistant</span>
      </header>

      <section class="conversation" data-transcript role="log" aria-live="polite" aria-relevant="additions text">
        <article class="message message--assistant" data-greeting>
          <span class="avatar" aria-hidden="true">AI</span>
          <div><strong>Public assistant</strong><p data-greeting-text>Ask a question, work through an idea, or ask about St. Expedite Press.</p></div>
        </article>
      </section>

      <footer class="composer-wrap">
        <form class="composer" id="composer" data-form>
          <div class="composer__attachment" data-attachment-preview hidden>
            <img data-attachment-thumb alt="Attached image">
            <button type="button" class="attachment-remove" data-attachment-remove aria-label="Remove attached image">×</button>
          </div>
          <label class="sr-only" for="message">Message</label>
          <textarea id="message" rows="2" maxlength="1000" placeholder="Message the assistant" data-input></textarea>
          <div class="composer__controls">
            <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" data-image-input hidden>
            <button type="button" class="attach-button" data-attach-image aria-label="Attach an image">📎</button>
            <div data-turnstile aria-label="Human verification"></div>
            <button type="button" class="text-button" data-stop hidden>Stop</button>
            <button type="submit" class="send" data-send aria-label="Send message">↑</button>
          </div>
        </form>
        <p class="live-status" data-status role="status"></p>
        <p class="disclaimer">Replies may be incomplete or wrong. Do not send manuscripts, passwords, payment information, or private correspondence in chat — use Submit work for manuscripts.</p>
      </footer>
    </main>
  </div>
  <dialog class="submission-dialog" data-submission-dialog aria-labelledby="submission-title">
    <div class="submission-dialog__header">
      <div><span class="eyebrow">CONSTRAINED HANDOFF</span><h2 id="submission-title">Submit a manuscript</h2></div>
      <button class="dialog-close" type="button" data-close-submission aria-label="Close submission form">×</button>
    </div>
    <p class="submission-intro">Your document is validated by the Worker and forwarded to the editor by email. The chat assistant cannot read it or retrieve it later.</p>
    <form class="submission-form" data-submission-form>
      <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" hidden>
      <label>Email<input name="email" type="email" maxlength="320" autocomplete="email" required></label>
      <label>Author name<input name="authorName" type="text" maxlength="120" autocomplete="name" required></label>
      <label>Title of work<input name="workTitle" type="text" maxlength="200" required></label>
      <label>Genre or form <span>(optional)</span><input name="genre" type="text" maxlength="80" placeholder="Poetry, fiction, essay, hybrid…"></label>
      <label>Project note<textarea name="note" rows="4" maxlength="6000" placeholder="A concise description of the work" required></textarea></label>
      <label>Manuscript file<input name="file" type="file" accept=".pdf,.doc,.docx,.odt,.rtf,.txt,.md" required><small>One PDF, DOC, DOCX, ODT, RTF, TXT, or Markdown file; 10 MiB maximum.</small></label>
      <label class="submission-consent"><input name="consent" type="checkbox" required><span>I have authority to submit this work and understand it will be forwarded to the editor by email.</span></label>
      <div data-submission-turnstile aria-label="Human verification"></div>
      <button class="submission-send" type="submit" data-submission-send>Forward to editor</button>
      <p class="submission-status" data-submission-status role="status" aria-live="polite"></p>
    </form>
  </dialog>

  <dialog class="submission-dialog" data-preset-dialog aria-labelledby="preset-title">
    <form data-preset-form method="dialog">
      <h2 id="preset-title">Build an assistant</h2>
      <p class="rail__note">Create a private Hermes assistant. Choose a main model and optionally a separate model Hermes may use for delegated subtasks.</p>
      <label for="preset-name">Assistant name</label>
      <input id="preset-name" name="name" type="text" maxlength="120" required>
      <label for="preset-persona">Instructions</label>
      <textarea id="preset-persona" name="persona_prompt" rows="3" maxlength="4000" placeholder="How should this assistant behave?"></textarea>
      <div data-preset-steps></div>
      <button type="button" class="new-chat" data-add-step>+ Add delegation model</button>
      <p class="submission-status" data-preset-status aria-live="polite"></p>
      <div class="submission-actions">
        <input type="file" accept="application/json" data-preset-import-input hidden>
        <button type="button" class="new-chat" data-preset-import hidden>Import file…</button>
        <button type="button" class="new-chat" data-preset-close>Cancel</button>
        <button type="submit" class="submission-send">Create assistant</button>
      </div>
    </form>
  </dialog>
</body>
</html>