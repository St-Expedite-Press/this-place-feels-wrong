---
import BasePortal from '../layouts/BasePortal.astro';
import siteData from '../data/site.json';

const { site, pages } = siteData;
const page = pages.index;
const press = site.wings.press;
const lab = site.wings.lab;
const homeMetaTitle = 'St. Expedite Press — Southern Fiction, Translation & Archive | New Orleans';
const homeMetaDescription = 'Night-minded books from New Orleans: original Southern fiction, archival recovery, translation, and experimental literary instruments from St. Expedite Press.';
const homeOgTitle = 'St. Expedite Press';
const homeOgDescription = 'A New Orleans press gathering fiction, archive, translation, and institutional pressure in the key of Night.';
---
<BasePortal
  title={homeOgTitle}
  description={homeMetaDescription}
  canonical={page.canonical}
  brandMode="ritual"
  ogTitle={homeOgTitle}
  ogDescription={homeOgDescription}
  pageTitle={homeMetaTitle}
  styles={['assets/css/footer.css', 'assets/css/portal.css']}
>
  <Fragment slot="head-extra">
    <link rel="preload" as="image" href="/assets/img/identity/expedite-seal-motion.svg" type="image/svg+xml" fetchpriority="high" />
  </Fragment>

  <main id="main" class="page" tabindex="-1">
    <h1 class="home-heading-sr">St. Expedite Press</h1>

    <div class="portal-mobile">
      <div class="wrap">
        <div class="mobile-fit">
          <section class="portal-stack">
            <div class="portal-link-row">
              <a class="portal-link" href={press.href}>{press.label}</a>
            </div>

            <div class="portal" aria-hidden="true">
              <picture class="portal-media portal-media--seal">
                <source srcset="/assets/img/identity/expedite-seal-motion.svg" type="image/svg+xml">
                <source srcset="/assets/img/identity/expedite-seal-green-768.webp" type="image/webp">
                <img src="/assets/img/identity/expedite-seal-green-768.png" alt="" width="768" height="768" fetchpriority="high" decoding="async">
              </picture>
            </div>

            <div class="portal-link-row">
              <a class="portal-link" href={lab.href}>{lab.label}</a>
            </div>
          </section>

          <footer class="foot">
            <p class="splash__eyebrow">29.9511&deg; N &mdash; 90.0715&deg; W</p>
            <p class="lede">...in the key of Night.</p>
            <div class="divider">&#9651; &#10013; &#9651;</div>

            <div class="thin-band">
              <form class="thin-form" id="splash-signup-mobile" novalidate>
                <label class="home-heading-sr" for="splash-email-mobile">Email address</label>
                <input class="thin-input" id="splash-email-mobile" name="email" type="email" autocomplete="email" inputmode="email" placeholder="your@email.com" required />
                <button class="thin-button" id="splash-submit-mobile" type="submit">Join</button>
              </form>
              <div class="thin-helper status-panel" id="splash-helper-mobile" role="status" aria-live="polite" hidden>
                <div data-status-text></div>
              </div>
            </div>

            <div class="splash__foot">
              <a href="/connect">Connect</a> // <a href="https://rice.stexpedite.press/">RICE</a> // <a href="/press/donate">Donate</a>
            </div>
          </footer>
        </div>
      </div>
    </div>

    <div class="portal-desktop">
      <div class="portal-flash"></div>

      <div class="portal-frame portal-frame--seal">
        <div class="portal-noise"></div>
        <picture class="portal-media portal-media--seal">
          <source srcset="/assets/img/identity/expedite-seal-motion.svg" type="image/svg+xml">
          <source srcset="/assets/img/identity/expedite-seal-green-768.webp" type="image/webp">
          <img src="/assets/img/identity/expedite-seal-green-768.png" alt="" width="768" height="768" fetchpriority="high" decoding="async">
        </picture>
      </div>

      <nav class="mobile-index-nav" aria-label="Primary">
        <a href={press.href}>{press.label}</a>
        <a href={lab.href}>{lab.label}</a>
      </nav>

      <nav class="big-nav" aria-label="Primary">
        <a href={press.href} class="big-word big-word--press">
          PRESS
          <span class="big-word__gloss">{press.tagline}</span>
        </a>
        <a href={lab.href} class="big-word big-word--lab">
          LAB
          <span class="big-word__gloss">{lab.tagline}</span>
        </a>
      </nav>

      <div class="splash">
        <p class="splash__eyebrow">29.9511&deg; N &mdash; 90.0715&deg; W</p>
        <p class="lede">...in the key of Night.</p>
        <div class="divider">&#9651; &#10013; &#9651;</div>

        <form class="splash__signup" id="splash-signup" novalidate>
          <p class="splash__signup-label">Dispatches from the press</p>
          <label class="home-heading-sr" for="splash-email">Email address</label>
          <input class="splash__input" id="splash-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="your@email.com" required />
          <button class="splash__join" id="splash-submit" type="submit">Join</button>
          <div class="splash__helper status-panel" id="splash-helper" role="status" aria-live="polite" hidden>
            <div data-status-text></div>
          </div>
        </form>

        <div class="splash__foot">
          <a href="/connect">Connect</a> // <a href="https://rice.stexpedite.press/">RICE</a> // <a href="/press/donate">Donate</a>
        </div>
      </div>
    </div>

  </main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/site-shell.js" type="module"></script>
    <script is:inline src="/assets/js/index-effects.js"></script>
    <script is:inline src="/assets/js/splash-entry.js" type="module"></script>

    <script is:inline>
    const applyMobileFit = () => {
      const mobileFit = document.querySelector('.portal-mobile .mobile-fit');
      const mobileWrap = document.querySelector('.portal-mobile .wrap');
      if (!mobileFit || !mobileWrap) return;

      const isMobileLayout = window.matchMedia('(max-width: 900px)').matches;
      if (!isMobileLayout) {
        mobileFit.style.removeProperty('--mobile-fit-scale');
        return;
      }

      mobileFit.style.setProperty('--mobile-fit-scale', '1');
      const availableWidth = mobileWrap.clientWidth;
      const availableHeight = mobileWrap.clientHeight;

      const contentWidth = mobileFit.scrollWidth;
      const contentHeight = mobileFit.scrollHeight;

      if (!contentWidth || !contentHeight) return;

      const scale = Math.min(1, availableWidth / contentWidth, availableHeight / contentHeight);
      mobileFit.style.setProperty('--mobile-fit-scale', String(Math.max(0.65, scale)));
    };

    let mobileFitTimer = 0;
    const scheduleMobileFit = (delayMs) => {
      window.clearTimeout(mobileFitTimer);
      mobileFitTimer = window.setTimeout(applyMobileFit, delayMs);
    };

    scheduleMobileFit(0);
    window.addEventListener('resize', () => scheduleMobileFit(60), { passive: true });
    window.addEventListener('orientationchange', () => scheduleMobileFit(250), { passive: true });
    window.addEventListener('load', () => scheduleMobileFit(0), { passive: true });
    document.fonts?.ready?.then?.(() => scheduleMobileFit(0));
    </script>
  </Fragment>
</BasePortal>
