---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.labPractice;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/services.css',
  'assets/css/spec.css',
];

const capabilities = [
  {
    name: 'Agentic systems & operations',
    work: 'Multi-agent pipelines with explicit input/output contracts between steps, human approval at the points that matter, and a system that can be stopped from a single message.',
    output: 'A running pipeline, its contracts, and the audit trail it writes.',
  },
  {
    name: 'Ontology & knowledge graphs',
    work: 'OWL/RDF ontologies and taxonomies as a semantic backbone, agent memory and persona compilation, and retrieval that can always show its source.',
    output: 'A graph, its schema, and a retrieval path with provenance attached.',
  },
  {
    name: 'Websites & digital publishing',
    work: 'Art direction, copy, information architecture, and implementation held to one idea — from static graph-driven front ends to application back ends.',
    output: 'A deployed site or application, documented well enough to hand over.',
  },
  {
    name: 'Editing, writing & translation',
    work: 'Developmental editing, translation, archival recovery, and long-form work requiring synthesis and cultural judgement.',
    output: 'Finished prose, in the register the work needs.',
  },
];

const phases = [
  {
    num: '01',
    name: 'Discovery',
    span: '1–2 weeks',
    detail: 'Model the problem, the audience, and the constraint. Ends with a written scope and a decision about whether to continue. Paid, and useful on its own if the answer is no.',
  },
  {
    num: '02',
    name: 'Build',
    span: 'Bulk of the work',
    detail: 'Delivery against the scope, in reviewable increments. Contracts between steps are fixed early so the shape stops moving.',
  },
  {
    num: '03',
    name: 'Handover',
    span: 'Final stage',
    detail: 'Documentation, procedure, and the access required to run it without the practice. The system should not need its author to keep working.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="lab"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block section-block--reading services-premise">
    <article class="card editorial-card stack">
      <p class="card-kicker">Who does the work</p>
      <h2 class="section-heading">One person, one or two projects at a time.</h2>
      <p class="section-copy section-copy--large">Christopher Sandbatch takes the work directly. That means the person who models your problem is the person who writes the ontology and ships the code, and it means capacity is genuinely limited — two substantial engagements at once is the ceiling, not a positioning device.</p>
      <p class="section-copy">The trade is deliberate. You lose the surge capacity of an agency and the account manager who returns calls faster. You get continuity of judgment, no translation loss between strategy and build, and someone who has to live with the architecture he chose.</p>
    </article>
  </section>

  <section class="section-block services-section" aria-labelledby="services-offers-title">
    <div class="section-header">
      <p class="card-kicker">What can be commissioned</p>
      <h2 class="section-heading" id="services-offers-title">Four principal forms of work</h2>
    </div>
    <table class="spec-table spec-table--matrix">
      <thead>
        <tr>
          <th scope="col">Form</th>
          <th scope="col">What the work is</th>
          <th scope="col">What you are left holding</th>
        </tr>
      </thead>
      <tbody>
        {capabilities.map(row => (
          <tr>
            <th scope="row">{row.name}</th>
            <td data-label="The work">{row.work}</td>
            <td data-label="Delivered">{row.output}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section-block" aria-labelledby="advanced-service-title">
    <div class="section-header">
      <p class="card-kicker">The harder cases</p>
      <h2 class="section-heading" id="advanced-service-title">When the project has become too complicated to reason about</h2>
      <p class="section-copy">Content, research, and AI systems reach a point where nobody can say what the system will do, because the rules live in a prompt, a spreadsheet, and someone's head. The work then is to build the governing layer: definitions that are written down, relationships that can be inspected, retrieval that cites its source, and a record of how any of it changed.</p>
      <p class="section-copy">That layer is the difference between a system you can argue with and one you can only restart. It is slower to build and it is the reason the systems here can publish their own constraints.</p>
    </div>
  </section>

  <section class="section-block service-evidence" aria-labelledby="service-evidence-title">
    <div class="section-header">
      <p class="card-kicker">Projects / proof of practice</p>
      <h2 class="section-heading" id="service-evidence-title">Systems already public, commissioned, or sold.</h2>
    </div>
    <div class="evidence-grid">
      <article class="card case-study">
        <p class="case-study__label">Recent commissioned work / 2026</p>
        <h3>Persona-based agentic systems &amp; operations back offices</h3>
        <p>Complete systems organized around personas and pipelines: distinct roles, voices, memory, grounded retrieval, and human review — with anti-fabrication and audit built in — rather than a single generic automation layer. Applied to marketing operations, catalog-scale content, and back-office infrastructure for under-resourced organizations.</p>
        <p>Several engagements were acquired or are under active build. Client and partner identities remain private by design; the underlying capabilities are available for new, independently scoped engagements.</p>
      </article>
      <div class="selected-work">
        <a class="work-link" href="/">
          <span>St. Expedite Press</span>
          <small>Identity, editorial system, website, commerce, and communications infrastructure</small>
        </a>
        <a class="work-link" href="https://rice.stexpedite.press/">
          <span>RICE Magazine</span>
          <small>Independent magazine identity, static publication system, and editorial image architecture</small>
        </a>
        <a class="work-link" href="https://ecoamericana.substack.com/">
          <span>Ecologica Americana</span>
          <small>Long-form writing, audience formation, cultural research, and public voice</small>
        </a>
        <a class="work-link" href="https://chat.stexpedite.press/">
          <span>St. Expedite Public Chat</span>
          <small>A Turnstile-gated public interface with server-resolved multi-model presets, grounded retrieval, and human-moderated custom assistants — no file, email, or deployment tools</small>
        </a>
        <a class="work-link" href="/press/books">
          <span>Books &amp; publishing</span>
          <small>Writing, editing, production, catalog strategy, and direct publication</small>
        </a>
      </div>
    </div>
  </section>

  <section class="section-block service-evidence" aria-labelledby="independent-projects-title">
    <div class="section-header">
      <p class="card-kicker">Independent projects</p>
      <h2 class="section-heading" id="independent-projects-title">Separate projects, built in the open.</h2>
    </div>
    <div class="selected-work">
      <a class="work-link" href="https://github.com/St-Expedite-Press/on-high-in-blue-tomorrows">
        <span>Signal Atlas</span>
        <small>An ontology-backed, graph-driven locality-intelligence interface — world-layer facts (events, sources, places, agents) projected into a rendered front end</small>
      </a>
      <a class="work-link" href="https://github.com/CSandbatch/novelgraph">
        <span>NovelGraph</span>
        <small>Fiction production through an inspectable story graph, scoped knowledge, and supervised workflows</small>
      </a>
      <a class="work-link" href="https://github.com/CSandbatch/freight-trust-knowledge-base">
        <span>Freight Trust Knowledge Base</span>
        <small>A public, read-only research knowledge base — an Obsidian-vault corpus with provenance controls and an agent-driven retrieval system</small>
      </a>
      <div class="work-link work-link--unlinked">
        <span>TexGraph <em>(private)</em></span>
        <small>A governed graph workspace — private repository, available on request</small>
      </div>
    </div>
  </section>

  <section class="section-block" aria-labelledby="engagement-title">
    <div class="section-header">
      <p class="card-kicker">Engagement shape</p>
      <h2 class="section-heading" id="engagement-title">How a project runs</h2>
      <p class="section-copy">One or two substantial engagements at a time, led directly, without account layers. Scoped by deliverables and decisions rather than indefinite activity.</p>
    </div>
    <ol class="phase-list">
      {phases.map(phase => (
        <li class="phase-list__item">
          <span class="phase-list__num">{phase.num}</span>
          <span class="phase-list__name">{phase.name}</span>
          <span class="phase-list__span">{phase.span}</span>
          <p class="phase-list__detail">{phase.detail}</p>
        </li>
      ))}
    </ol>
    <div class="actions">
      <a class="button" href="/lab/schedule">Book a call</a>
      <a class="button-secondary" href="/lab/architecture">See how the machinery is bounded</a>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/site-shell.js" type="module"></script>
  </Fragment>
</Base>
