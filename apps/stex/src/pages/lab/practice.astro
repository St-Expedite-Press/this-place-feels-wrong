---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.labPractice;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/services.css',
  'assets/css/spec.css',
];

const capabilities = [
  {
    name: 'Aesthetic product systems',
    work: 'Art direction, interface design, copy, and information architecture for founders whose product needs a recognizable public surface rather than a generic application shell.',
    output: 'A coherent product language and a deployed interface tied to the system beneath it.',
  },
  {
    name: 'Memory & knowledge layers',
    work: 'Ontologies, knowledge graphs, structured memory, provenance-aware retrieval, and context compilation for products that need continuity rather than stateless prompting.',
    output: 'A memory and retrieval layer with an inspectable schema, sources, and operating rules.',
  },
  {
    name: 'Specialized creative agents',
    work: 'Agents for editorial, research, writing, design, cultural analysis, and other creative domains where voice, judgment, and bounded context matter more than generic task automation.',
    output: 'A specialized agent or agent team with explicit roles, memory boundaries, evaluation criteria, and human review points.',
  },
  {
    name: 'Agent systems & infrastructure',
    work: 'Pipelines, profile routing, model abstraction, permissions, audit trails, and application infrastructure that turn experimental agents into systems a small team can actually operate.',
    output: 'A running system, its contracts and controls, and documentation sufficient for handover.',
  },
];

const phases = [
  {
    num: '01',
    name: 'Discovery',
    span: '1–2 weeks',
    detail: 'Define the problem, the constraints, the users, and the success conditions. Produces a written scope and a go/no-go decision.',
  },
  {
    num: '02',
    name: 'Build',
    span: 'Bulk of the work',
    detail: 'Implementation against the agreed scope, delivered in reviewable increments. Interfaces between design, data, memory, and agent behaviour are fixed early to limit rework.',
  },
  {
    num: '03',
    name: 'Handover',
    span: 'Final stage',
    detail: 'Documentation, operating procedure, and access transfer, so the system can be run and modified without further involvement.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="lab"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block section-block--reading services-premise">
    <article class="card editorial-card stack">
      <p class="card-kicker">Who the work is for</p>
      <h2 class="section-heading">Founders building unusual products</h2>
      <p class="section-copy section-copy--large">The Lab works primarily with startups, founders, and small teams whose product needs a strong aesthetic identity and a nontrivial intelligence layer: persistent memory, structured knowledge, specialized agents, or some combination of them.</p>
      <p class="section-copy">Christopher Sandbatch handles scoping, architecture, design direction, and implementation directly. That continuity suits products where the hard problem sits between disciplines; it does not suit work that needs parallel delivery teams or an account-management layer.</p>
    </article>
  </section>

  <section class="section-block services-section" aria-labelledby="services-offers-title">
    <div class="section-header">
      <p class="card-kicker">What can be commissioned</p>
      <h2 class="section-heading" id="services-offers-title">Four principal forms of work</h2>
    </div>
    <table class="spec-table spec-table--matrix">
      <thead>
        <tr>
          <th scope="col">Form</th>
          <th scope="col">Scope</th>
          <th scope="col">Deliverable</th>
        </tr>
      </thead>
      <tbody>
        {capabilities.map(row => (
          <tr>
            <th scope="row">{row.name}</th>
            <td data-label="Scope">{row.work}</td>
            <td data-label="Deliverable">{row.output}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section-block" aria-labelledby="advanced-service-title">
    <div class="section-header">
      <p class="card-kicker">Governance layer</p>
      <h2 class="section-heading" id="advanced-service-title">When the product needs memory, not another prompt</h2>
      <p class="section-copy">Creative AI products often reach a point where behavior becomes difficult to reason about because identity, memory, retrieval, and workflow rules are scattered across prompt text and ad hoc application state. The remedy is a governing layer: written definitions, inspectable relationships, retrieval that returns its sources, and a change record.</p>
      <p class="section-copy">That layer is what lets a specialized agent retain character and context without turning the rest of the application into an undocumented prompt pile.</p>
    </div>
  </section>

  <section class="section-block service-evidence" aria-labelledby="service-evidence-title">
    <div class="section-header">
      <p class="card-kicker">Flagship proof of practice</p>
      <h2 class="section-heading" id="service-evidence-title">Signal Atlas</h2>
    </div>
    <div class="evidence-grid">
      <article class="card case-study card--feature">
        <p class="case-study__label">Flagship system / active build</p>
        <h3>Locality intelligence as a designed world model</h3>
        <p>Signal Atlas is an ontology-backed, graph-driven locality-intelligence product. Events, sources, places, and agents live in a structured world layer; the interface is a projection of that model rather than a separate skin placed over it.</p>
        <p>It demonstrates the combination the Lab is built to sell: aesthetic direction, information architecture, structured memory, provenance-aware retrieval, agent behavior, and a rendered product surface designed together.</p>
        <div class="actions">
          <a class="button" href="https://github.com/St-Expedite-Press/on-high-in-blue-tomorrows" target="_blank" rel="noopener noreferrer">Inspect Signal Atlas</a>
        </div>
      </article>
      <div class="selected-work">
        <a class="work-link" href="https://chat.stexpedite.press/">
          <span>St. Expedite Chat</span>
          <small>A general AI assistant product and agent-framework showcase built around isolated Hermes profiles, memory boundaries, and first-party routing</small>
        </a>
        <a class="work-link" href="/">
          <span>St. Expedite Press</span>
          <small>Identity, editorial system, website, commerce, and communications infrastructure</small>
        </a>
        <a class="work-link" href="https://rice.stexpedite.press/">
          <span>RICE Magazine</span>
          <small>Independent magazine identity, static publication system, and editorial image architecture</small>
        </a>
        <a class="work-link" href="https://ecoamericana.substack.com/">
          <span>Ecologica Americana</span>
          <small>Long-form writing, audience formation, cultural research, and public voice</small>
        </a>
      </div>
    </div>
  </section>

  <section class="section-block service-evidence" aria-labelledby="independent-projects-title">
    <div class="section-header">
      <p class="card-kicker">Additional systems</p>
      <h2 class="section-heading" id="independent-projects-title">Other work built in the open</h2>
    </div>
    <div class="selected-work">
      <a class="work-link" href="https://github.com/CSandbatch/novelgraph">
        <span>NovelGraph</span>
        <small>Fiction production through an inspectable story graph, scoped knowledge, and supervised workflows</small>
      </a>
      <a class="work-link" href="https://github.com/CSandbatch/freight-trust-knowledge-base">
        <span>Freight Trust Knowledge Base</span>
        <small>A public, read-only research knowledge base with provenance controls and agent-driven retrieval</small>
      </a>
      <div class="work-link work-link--unlinked">
        <span>TexGraph <em>(private)</em></span>
        <small>A governed graph workspace — private repository, available on request</small>
      </div>
    </div>
  </section>

  <section class="section-block" aria-labelledby="engagement-title">
    <div class="section-header">
      <p class="card-kicker">Engagement shape</p>
      <h2 class="section-heading" id="engagement-title">How a project runs</h2>
      <p class="section-copy">There is no public rate card. Start with a free 30-minute consultation; if there is a fit, the work is scoped to concrete deliverables and decisions rather than an open-ended retainer.</p>
    </div>
    <ol class="phase-list">
      {phases.map(phase => (
        <li class="phase-list__item">
          <span class="phase-list__num">{phase.num}</span>
          <span class="phase-list__name">{phase.name}</span>
          <span class="phase-list__span">{phase.span}</span>
          <p class="phase-list__detail">{phase.detail}</p>
        </li>
      ))}
    </ol>
    <div class="actions">
      <a class="button" href="/lab/schedule">Book a free 30-minute consultation</a>
      <a class="button-secondary" href="/lab/architecture">Architecture reference</a>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/site-shell.js" type="module"></script>
  </Fragment>
</Base>
