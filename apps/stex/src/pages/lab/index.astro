---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.lab;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/spec.css',
];

const contents = [
  {
    num: '01',
    href: '/lab/instruments',
    name: 'Instruments',
    detail: 'The American Anglossic Compass — forty prompts, five axes, seven archetypes, and a reading at the end. Runs in the browser in a few minutes.',
    meta: 'Runnable now',
  },
  {
    num: '02',
    href: '/lab/architecture',
    name: 'Architecture',
    detail: 'The request path for the public assistant, where each control is enforced, and the fifteen capabilities it is denied. Rendered from the policy file the profile actually runs on.',
    meta: 'Published constraints',
  },
  {
    num: '03',
    href: '/lab/practice',
    name: 'Practice',
    detail: 'The four forms of work that can be commissioned, what each leaves you holding, and the three phases a project moves through.',
    meta: 'What to commission',
  },
  {
    num: '04',
    href: '/lab/schedule',
    name: 'Schedule',
    detail: 'A short first call to establish whether there is a project here. No charge, no obligation afterwards.',
    meta: 'Start here',
  },
];

const principles = [
  {
    name: 'One pair of hands',
    detail: 'Strategy and execution stay with the same person, from the first model of an audience to the last line of code. There is no account layer and nothing is subcontracted out of view.',
  },
  {
    name: 'Structure over prompt',
    detail: 'Relationships are explicit and inspectable — ontologies, contracts between pipeline steps, retrieval that can show its source — rather than buried in a prompt someone else can silently change.',
  },
  {
    name: 'Constraints in public',
    detail: 'The systems built here publish what they cannot do. The public assistant’s denial list is on this site, generated from its own configuration.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="lab"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block" aria-labelledby="contents-title">
    <div class="section-header">
      <p class="card-kicker">Contents</p>
      <h2 class="section-heading" id="contents-title">What is here</h2>
    </div>
    <ol class="doc-index">
      {contents.map(entry => (
        <li class="doc-index__item">
          <a class="doc-index__link" href={entry.href}>
            <span class="doc-index__num">{entry.num}</span>
            <span class="doc-index__name">{entry.name}</span>
            <span class="doc-index__meta">{entry.meta}</span>
            <span class="doc-index__detail">{entry.detail}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-block" aria-labelledby="principles-title">
    <div class="section-header">
      <p class="card-kicker">How the work is done</p>
      <h2 class="section-heading" id="principles-title">Three commitments that shape everything else</h2>
    </div>
    <dl class="doc-defs">
      {principles.map(item => (
        <div class="doc-defs__row">
          <dt class="doc-defs__term">{item.name}</dt>
          <dd class="doc-defs__desc">{item.detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section-block section-block--reading" aria-labelledby="crossing-title">
    <div class="doc-note">
      <p class="card-kicker">The other side</p>
      <h2 class="section-heading" id="crossing-title">There is also a Press.</h2>
      <p class="section-copy section-copy--large">St. Expedite publishes Southern fiction, recovery editions, and translation out of New Orleans. The commissioned work here is what pays for that building.</p>
      <div class="actions">
        <a class="button" href="/lab/schedule">Book a call</a>
        <a class="button-secondary" href="/press">Go to the Press</a>
      </div>
    </div>
  </section>
</Base>
