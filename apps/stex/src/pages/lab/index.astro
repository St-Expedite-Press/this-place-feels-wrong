---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.lab;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/spec.css',
];

const contents = [
  {
    num: '01',
    href: '/lab/instruments',
    name: 'Instruments',
    detail: 'The American Anglossic Compass. Forty prompts across five axes, scored against seven archetypes. Runs in the browser in a few minutes.',
    meta: 'Working example',
  },
  {
    num: '02',
    href: '/lab/architecture',
    name: 'Architecture',
    detail: 'The request path for the public assistant, where each control is applied, and the fifteen capabilities it is denied. Generated from the profile configuration.',
    meta: 'Reference',
  },
  {
    num: '03',
    href: '/lab/practice',
    name: 'Practice',
    detail: 'Four forms of work, the deliverable for each, and the three phases an engagement moves through.',
    meta: 'Services',
  },
  {
    num: '04',
    href: '/lab/schedule',
    name: 'Schedule',
    detail: 'A short introductory call to establish scope and fit. No charge and no obligation.',
    meta: 'Contact',
  },
];

const principles = [
  {
    name: 'Direct delivery',
    detail: 'The person who scopes the work writes the schema and ships the code. There is no account management layer and no subcontracting.',
  },
  {
    name: 'Explicit structure',
    detail: 'System behaviour lives in schemas, contracts between pipeline steps, and configuration rather than in prompt text. Retrieval returns its sources.',
  },
  {
    name: 'Documented limits',
    detail: 'Systems ship with their constraints written down and generated from configuration, so the documentation cannot drift from what is deployed.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="lab"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block" aria-labelledby="contents-title">
    <div class="section-header">
      <p class="card-kicker">Contents</p>
      <h2 class="section-heading" id="contents-title">Sections</h2>
    </div>
    <ol class="doc-index">
      {contents.map(entry => (
        <li class="doc-index__item">
          <a class="doc-index__link" href={entry.href}>
            <span class="doc-index__num">{entry.num}</span>
            <span class="doc-index__name">{entry.name}</span>
            <span class="doc-index__meta">{entry.meta}</span>
            <span class="doc-index__detail">{entry.detail}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-block" aria-labelledby="principles-title">
    <div class="section-header">
      <p class="card-kicker">How engagements work</p>
      <h2 class="section-heading" id="principles-title">Constants across engagements</h2>
    </div>
    <dl class="doc-defs">
      {principles.map(item => (
        <div class="doc-defs__row">
          <dt class="doc-defs__term">{item.name}</dt>
          <dd class="doc-defs__desc">{item.detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section-block section-block--reading" aria-labelledby="crossing-title">
    <div class="doc-note">
      <p class="card-kicker">Related</p>
      <h2 class="section-heading" id="crossing-title">St. Expedite Press</h2>
      <p class="section-copy section-copy--large">The Lab shares an operation with a publishing house in New Orleans, which issues Southern fiction, recovery editions, and translation. Commissioned work funds it.</p>
      <div class="actions">
        <a class="button" href="/lab/schedule">Book a call</a>
        <a class="button-secondary" href="/press">Go to the Press</a>
      </div>
    </div>
  </section>
</Base>
