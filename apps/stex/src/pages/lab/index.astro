---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.lab;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/wings.css',
];

const rooms = [
  {
    href: '/lab/architecture',
    kicker: 'How it runs',
    title: 'Architecture',
    copy: 'The request path for the public assistant, where each control is enforced, and the capability list it is denied — rendered from the policy file itself.',
  },
  {
    href: '/lab/practice',
    kicker: 'Commissioned work',
    title: 'Practice',
    copy: 'Agent systems, knowledge graphs, publishing infrastructure, and editorial work. Led directly, one or two projects at a time.',
  },
  {
    href: '/lab/schedule',
    kicker: 'Scheduling',
    title: 'Book a call',
    copy: 'A short first call to work out whether there is a project here. Free, and no obligation after it.',
  },
  {
    href: 'https://chat.stexpedite.press',
    kicker: 'Public assistant',
    title: 'Chat',
    copy: 'A public assistant with grounded retrieval, and private ones you own. It holds no file, email, or deployment access.',
    external: true,
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="lab"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block lab-lead" aria-labelledby="lab-lead-title">
    <article class="card card--feature stack">
      <p class="card-kicker">Working instrument</p>
      <h2 class="section-heading section-heading--display" id="lab-lead-title">American Anglossic Compass</h2>
      <p class="section-copy section-copy--large">Forty prompts across five axes resolve through seven archetypes into a reading. It takes a few minutes, the order shuffles on each run, and it holds your place if you stop. Nothing about it is a mockup — it is the clearest look at how the Lab builds.</p>
      <div class="actions">
        <a class="button" href="/lab/instruments">Run the Compass</a>
        <a class="button-secondary" href="/lab/architecture">How it is bounded</a>
      </div>
    </article>
  </section>

  <section class="section-block wing-rooms" aria-labelledby="lab-rooms-title">
    <div class="section-header">
      <p class="card-kicker">Where to start</p>
      <h2 class="section-heading" id="lab-rooms-title">The rest of it.</h2>
    </div>
    <div class="section-grid section-grid--two">
      {rooms.map(room => (
        <a
          class="card wing-room"
          href={room.href}
          target={room.external ? '_blank' : undefined}
          rel={room.external ? 'noopener noreferrer' : undefined}
        >
          <p class="card-kicker">{room.kicker}</p>
          <h3 class="wing-room__title">{room.title}</h3>
          <p class="section-copy">{room.copy}</p>
          <span class="wing-room__cue" aria-hidden="true">&#8594;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block section-block--reading wing-crossing" aria-labelledby="lab-crossing-title">
    <article class="card quiet-panel stack">
      <p class="card-kicker">The other side</p>
      <h2 class="section-heading" id="lab-crossing-title">There is also a Press.</h2>
      <p class="section-copy section-copy--large">St. Expedite publishes Southern fiction, recovery editions, and translation out of New Orleans. That is the older half of the operation.</p>
      <div class="actions">
        <a class="button" href="/press">Go to the Press</a>
      </div>
    </article>
  </section>
</Base>
