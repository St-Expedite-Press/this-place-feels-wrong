---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.lab;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/spec.css',
];

const contents = [
  {
    num: '01',
    href: '/lab/signal-atlas',
    name: 'Signal Atlas',
    detail: 'The flagship system. A locality-intelligence surface for New Orleans built on one structured world model: sources, events, places, and curated sets queried through a single graph and projected into a map, a reading grid, and a classifieds rail.',
    meta: 'FLAGSHIP SYSTEM',
  },
  {
    num: '02',
    href: '/lab/practice',
    name: 'Practice',
    detail: 'Aesthetic product systems, memory and knowledge layers, specialized creative agents, and the infrastructure that makes them operable.',
    meta: 'COMMISSIONED WORK',
  },
  {
    num: '03',
    href: '/lab/architecture',
    name: 'Architecture',
    detail: 'The request path for the public assistant, where each control is applied, and the capabilities it is denied. Generated from the profile configuration.',
    meta: 'REFERENCE',
  },
  {
    num: '04',
    href: '/lab/instruments',
    name: 'Instruments',
    detail: 'The American Anglossic Compass. Forty prompts across five axes, scored against seven archetypes. Runs in the browser in a few minutes.',
    meta: 'WORKING EXAMPLE',
  },
  {
    num: '05',
    href: '/lab/schedule',
    name: 'Schedule',
    detail: 'A free 30-minute introductory consultation to establish what you are building, where the difficult part is, and whether the Lab is a fit.',
    meta: 'FREE CONSULTATION',
  },
];

const principles = [
  {
    name: 'Design and intelligence together',
    detail: 'Interface, information architecture, memory, retrieval, and agent behaviour are treated as parts of the same product rather than separate vendor layers.',
  },
  {
    name: 'Explicit structure',
    detail: 'System behaviour lives in schemas, contracts between pipeline steps, and configuration rather than in prompt text. Retrieval returns its sources.',
  },
  {
    name: 'Direct delivery',
    detail: 'The person who scopes the work handles the architecture and implementation. There is no account management layer and no subcontracting.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="lab"
  brandMode="editorial"
  styles={styles}
>
  <section class="lab-control-strip" aria-label="Document control">
    <span>STEX/LAB</span>
    <span>PUBLIC BRIEF</span>
    <span>REV 01</span>
    <span>STATUS: OPERATING</span>
  </section>

  <section class="section-block" aria-labelledby="contents-title">
    <div class="section-header">
      <p class="card-kicker">Contents</p>
      <h2 class="section-heading" id="contents-title">Operating surfaces</h2>
    </div>
    <ol class="doc-index">
      {contents.map(entry => (
        <li class="doc-index__item">
          <a class="doc-index__link" href={entry.href}>
            <span class="doc-index__num">{entry.num}</span>
            <span class="doc-index__name">{entry.name}</span>
            <span class="doc-index__meta">{entry.meta}</span>
            <span class="doc-index__detail">{entry.detail}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-block" aria-labelledby="principles-title">
    <div class="section-header">
      <p class="card-kicker">Delivery controls</p>
      <h2 class="section-heading" id="principles-title">Constants across engagements</h2>
    </div>
    <dl class="doc-defs">
      {principles.map(item => (
        <div class="doc-defs__row">
          <dt class="doc-defs__term">{item.name}</dt>
          <dd class="doc-defs__desc">{item.detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section-block section-block--reading" aria-labelledby="crossing-title">
    <div class="doc-note">
      <p class="card-kicker">Adjacent operation</p>
      <h2 class="section-heading" id="crossing-title">St. Expedite Press</h2>
      <p class="section-copy section-copy--large">The Lab shares an operation with a publishing house in New Orleans, which issues Southern fiction, recovery editions, and translation. Commissioned work funds it.</p>
      <div class="actions">
        <a class="button" href="/lab/schedule">Open intake</a>
        <a class="button-secondary" href="/press">Cross to the Press</a>
      </div>
    </div>
  </section>
</Base>
