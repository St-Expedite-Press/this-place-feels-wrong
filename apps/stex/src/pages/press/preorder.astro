---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';
import preorder from '../../data/preorder.json';

const page = siteData.pages.preorder;
const { campaign, editions, sets } = preorder;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/forms.css',
  'assets/css/preorder.css',
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="press"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block preorder-editions" aria-labelledby="editions-title">
    <div class="section-header">
      <p class="card-kicker">The editions</p>
      <h2 class="section-heading" id="editions-title">What you can order</h2>
      <p class="section-copy">The symphony comes in two volumes — the main collection, and a companion of translation and essays. Either stands on its own. The sets below cost less than buying the parts separately.</p>
    </div>

    {editions.map(group => (
      <article class="edition-group">
        <header class="edition-group__head">
          <p class="edition-group__kicker">{group.group}</p>
          <h3 class="edition-group__title">{group.work}</h3>
        </header>
        <ul class="edition-list">
          {group.items.map(item => (
            <li class="edition-row">
              <span class="edition-row__binding">{item.binding}</span>
              <span class="edition-row__spec">{item.trim}</span>
              <span class="edition-row__spec">{item.extent}</span>
              <span class="edition-row__price">{item.price}</span>
              {item.note && <span class="edition-row__note">{item.note}</span>}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="section-block preorder-sets" aria-labelledby="sets-title">
    <div class="section-header">
      <p class="card-kicker">The sets</p>
      <h2 class="section-heading" id="sets-title">Both volumes together</h2>
    </div>
    <div class="set-grid">
      {sets.map(set => (
        <article class="set-card">
          <h3 class="set-card__name">{set.name}</h3>
          <p class="set-card__contents">{set.contents}</p>
          <p class="set-card__pricing">
            <span class="set-card__parts"><s>{set.parts}</s></span>
            <span class="set-card__price">{set.price}</span>
          </p>
          <p class="set-card__saving">Saves {set.saving}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block section-block--reading preorder-order" aria-labelledby="order-title">
    <article class="card quiet-panel stack">
      <p class="card-kicker">Order</p>
      <h2 class="section-heading" id="order-title">Order direct from the press</h2>
      <p class="section-copy section-copy--large">Payment is taken now and the press ships the whole order itself, in one parcel. Shipping is a flat rate within the United States. These are pre-orders: the books go out when the run is complete.</p>

      <form class="preorder-form" id="order-form" novalidate>
        <div class="field">
          <label for="order-package">Edition or set</label>
          <select class="input" id="order-package" name="packageId">
            <optgroup label="Sets">
              {sets.map(set => (
                <option value={set.id} data-shirt={set.contents.includes('shirt') ? 'true' : 'false'}>{set.name} — {set.price}</option>
              ))}
            </optgroup>
            <optgroup label="Single volumes">
              <option value="main-softcover" data-shirt="false">Main collection, softcover — $17.99</option>
              <option value="main-hardcover" data-shirt="false">Main collection, hardcover numbered — $39.99</option>
              <option value="companion-softcover" data-shirt="false">Companion, softcover — $12.99</option>
              <option value="companion-hardcover" data-shirt="false">Companion, hardcover — $22.99</option>
            </optgroup>
          </select>
        </div>

        <div class="field" id="order-size-field" hidden>
          <label for="order-size">Shirt size</label>
          <select class="input" id="order-size" name="shirtSize">
            <option value="S">Small</option>
            <option value="M">Medium</option>
            <option value="L">Large</option>
            <option value="XL">Extra large</option>
            <option value="XXL">2XL</option>
          </select>
        </div>

        <div class="cf-turnstile" data-sitekey="0x4AAAAAADc-GOYeYwVaZA_I" data-theme="dark" data-appearance="interaction-only"></div>

        <div class="actions">
          <button class="button" id="order-submit" type="submit">Continue to payment</button>
        </div>

        <div class="status-panel" id="order-helper" role="status" aria-live="polite" hidden>
          <div data-status-text></div>
        </div>
      </form>

      <ul class="meta-list preorder-terms">
        <li>Payment is handled by Stripe. The press never sees your card details.</li>
        <li>Flat-rate shipping within the United States, added at checkout.</li>
        <li>Everything in an order ships together, in one parcel, when the run is ready.</li>
        <li>Write to <a href="/lab/schedule">the press</a> for anything unusual — overseas, bulk, or trade.</li>
      </ul>
    </article>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script is:inline src="/assets/js/site-shell.js" type="module"></script>
    <script is:inline src="/assets/js/order-entry.js" type="module"></script>
  </Fragment>
</Base>
