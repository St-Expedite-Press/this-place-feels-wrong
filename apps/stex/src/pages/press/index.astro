---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.press;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/wings.css',
];

const rooms = [
  {
    href: '/press/books',
    kicker: 'Catalog / 01',
    title: 'Books',
    copy: 'Original work, recovery editions, and translation. The catalog is the program.',
  },
  {
    href: '/press/store',
    kicker: 'Objects / 02',
    title: 'Store',
    copy: 'Books, prints, and objects from the press room. Stock is irregular by design and circumstance.',
  },
  {
    href: '/press/about',
    kicker: 'Premise / 03',
    title: 'About',
    copy: 'Gather the limbs of Osiris: the institutional argument behind the catalog and its recovery work.',
  },
];

const secondary = [
  {
    href: 'https://rice.stexpedite.press/',
    kicker: 'Magazine',
    title: 'RICE',
    copy: 'Essays, fiction, poetry, and archive on its own schedule.',
    external: true,
  },
  {
    href: '/connect?about=manuscript',
    kicker: 'Submissions',
    title: 'Send a manuscript',
    copy: 'Lead with the work: genre, length, and stage are useful.',
  },
  {
    href: '/press/donate',
    kicker: 'Direct support',
    title: 'Donate',
    copy: 'Money here pays for printing and archive work.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="press"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block wing-rooms" aria-labelledby="press-rooms-title">
    <div class="section-header">
      <p class="card-kicker">The press room</p>
      <h2 class="section-heading section-heading--display" id="press-rooms-title">Three doors into the work.</h2>
    </div>
    <div class="section-grid section-grid--two">
      {rooms.map(room => (
        <a class="card wing-room" href={room.href}>
          <p class="card-kicker">{room.kicker}</p>
          <h3 class="wing-room__title">{room.title}</h3>
          <p class="section-copy">{room.copy}</p>
          <span class="wing-room__cue" aria-hidden="true">&#8594;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block section-block--reading" aria-labelledby="press-list-title">
    <div class="section-header">
      <p class="card-kicker">Word from the press</p>
      <h2 class="section-heading" id="press-list-title">New books begin here.</h2>
    </div>
    <p class="section-copy">Publication notices, pre-orders, new catalog entries, and RICE go to the list first.</p>

    <form class="form-grid press-list-form" id="press-signup" novalidate>
      <div class="field">
        <label for="press-email">Email address</label>
        <input class="input" id="press-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="your@email.com" required />
      </div>
      <div class="cf-turnstile" data-sitekey="0x4AAAAAADc-GOYeYwVaZA_I" data-theme="dark" data-appearance="interaction-only"></div>
      <div class="actions">
        <button class="button" id="press-submit" type="submit">Join the list</button>
      </div>
      <div class="status-panel" id="press-helper" role="status" aria-live="polite" hidden>
        <div data-status-text></div>
      </div>
    </form>
  </section>

  <section class="section-block section-block--reading" aria-labelledby="press-secondary-title">
    <div class="section-header">
      <p class="card-kicker">Elsewhere in the operation</p>
      <h2 class="section-heading" id="press-secondary-title">Magazine, submissions, support.</h2>
    </div>
    <div class="press-colophon-list">
      {secondary.map(item => (
        <a
          class="press-colophon-link"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <span class="press-colophon-link__kicker">{item.kicker}</span>
          <span class="press-colophon-link__title">{item.title}</span>
          <span class="press-colophon-link__copy">{item.copy}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block section-block--reading wing-crossing" aria-labelledby="press-crossing-title">
    <div class="doc-note">
      <p class="card-kicker">The other side</p>
      <h2 class="section-heading" id="press-crossing-title">St. Expedite Lab</h2>
      <p class="section-copy section-copy--large">The same operation also builds agent systems, knowledge graphs, and publishing infrastructure on commission.</p>
      <div class="actions">
        <a class="button-secondary" href="/lab">Cross to the Lab</a>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script is:inline src="/assets/js/site-shell.js" type="module"></script>
    <script is:inline src="/assets/js/press-signup.js" type="module"></script>
  </Fragment>
</Base>
