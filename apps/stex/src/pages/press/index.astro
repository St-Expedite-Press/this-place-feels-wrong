---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.press;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/spec.css',
];

const catalog = [
  {
    num: '01',
    href: '/press/preorder',
    name: 'Lift Wind / Love Heat',
    meta: 'Forthcoming',
    detail: 'The manuscript is complete and is now in editing and typesetting. Editions and direct ordering are open.',
  },
  {
    num: '02',
    href: '/press/books',
    name: 'Books',
    meta: 'Catalog',
    detail: 'Browse original work from Southern Experimental Press, recovery editions, and translation.',
  },
  {
    num: '03',
    href: 'https://rice.stexpedite.press/',
    name: 'RICE',
    meta: 'Journal',
    detail: 'Essays, fiction, poetry, translation, and archival work. The print journal is the press’s next institutional threshold.',
    external: true,
  },
  {
    num: '04',
    href: '/press/about',
    name: 'About the Press',
    meta: 'Institution',
    detail: 'The catalog, the reconstruction project behind it, and the sequence from a meaningful catalog to a journal and eventually a fellowship.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="press"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block section-block--reading" aria-labelledby="press-signup-title">
    <article class="card card--feature stack">
      <p class="card-kicker">Word from the press</p>
      <h2 class="section-heading section-heading--display" id="press-signup-title">New books begin here.</h2>
      <p class="section-copy section-copy--large">Join the list for publication notices, pre-orders, new catalog entries, and RICE. The catalog is immediately below.</p>

      <form class="form-grid" id="press-signup" novalidate>
        <div class="field">
          <label for="press-email">Email address</label>
          <input class="input" id="press-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="your@email.com" required />
        </div>
        <div class="cf-turnstile" data-sitekey="0x4AAAAAADc-GOYeYwVaZA_I" data-theme="dark" data-appearance="interaction-only"></div>
        <div class="actions">
          <button class="button" id="press-submit" type="submit">Join the list</button>
        </div>
        <div class="status-panel" id="press-helper" role="status" aria-live="polite" hidden>
          <div data-status-text></div>
        </div>
      </form>
    </article>
  </section>

  <section class="section-block" aria-labelledby="press-catalog-title">
    <div class="section-header">
      <p class="card-kicker">The press</p>
      <h2 class="section-heading" id="press-catalog-title">Current work and catalog</h2>
    </div>
    <ol class="doc-index">
      {catalog.map(entry => (
        <li class="doc-index__item">
          <a
            class="doc-index__link"
            href={entry.href}
            target={entry.external ? '_blank' : undefined}
            rel={entry.external ? 'noopener noreferrer' : undefined}
          >
            <span class="doc-index__num">{entry.num}</span>
            <span class="doc-index__name">{entry.name}</span>
            <span class="doc-index__meta">{entry.meta}</span>
            <span class="doc-index__detail">{entry.detail}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-block section-block--reading" aria-labelledby="press-utilities-title">
    <div class="doc-note">
      <p class="card-kicker">Other business</p>
      <h2 class="section-heading" id="press-utilities-title">Store, submissions, and support</h2>
      <p class="section-copy">Use these after the catalog: objects from the press, manuscript inquiries, direct support, or the technical practice that helps fund the publishing work.</p>
      <div class="actions">
        <a class="button-secondary" href="/press/store">Store</a>
        <a class="button-secondary" href="/connect?about=manuscript">Send a manuscript</a>
        <a class="button-secondary" href="/press/donate">Donate</a>
        <a class="pill-link" href="/lab">St. Expedite Lab</a>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script is:inline src="/assets/js/site-shell.js" type="module"></script>
    <script is:inline src="/assets/js/press-signup.js" type="module"></script>
  </Fragment>
</Base>
