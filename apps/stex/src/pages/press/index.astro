---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site.json';

const page = siteData.pages.press;
const styles = [
  'assets/css/tokens.css',
  'assets/css/interior-base.css',
  'assets/css/layout.css',
  'assets/css/components.css',
  'assets/css/wings.css',
];

const primaryRooms = [
  {
    href: '/press/books',
    kicker: 'Catalog',
    title: 'Books',
    copy: 'Three arms: original fiction, recovery editions, and translation. Each holds a different kind of pressure.',
  },
  {
    href: '/press/store',
    kicker: 'Objects',
    title: 'Store',
    copy: 'Prints, objects, and whatever the press has run off lately. Stock is irregular.',
  },
  {
    href: '/press/about',
    kicker: 'The premise',
    title: 'About',
    copy: 'Gather the limbs of Osiris — rebuild a Southern literary institution outside the approval systems that flatten it.',
  },
];

const related = [
  {
    href: 'https://rice.stexpedite.press/',
    kicker: 'Magazine',
    title: 'RICE',
    copy: 'Essays, fiction, poetry, and archive, published on its own schedule.',
    external: true,
  },
  {
    href: '/connect?about=manuscript',
    kicker: 'Submissions',
    title: 'Send a manuscript',
    copy: 'One concise inquiry, then materials by reply. Lead with the work — genre, length, and stage are useful.',
  },
  {
    href: '/press/donate',
    kicker: 'Direct support',
    title: 'Donate',
    copy: 'Money here pays for printing and archive work. Nothing else.',
  },
];
---
<Base
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  introKicker={page.introKicker}
  introTitle={page.introTitle}
  introText={page.introText}
  canonical={page.canonical}
  currentNav={page.currentNav}
  wing="press"
  brandMode="editorial"
  styles={styles}
>
  <section class="section-block wing-rooms" aria-labelledby="press-rooms-title">
    <div class="section-header">
      <p class="card-kicker">The press</p>
      <h2 class="section-heading" id="press-rooms-title">Three ways in.</h2>
    </div>
    <div class="section-grid section-grid--three">
      {primaryRooms.map(room => (
        <a class="card wing-room" href={room.href}>
          <p class="card-kicker">{room.kicker}</p>
          <h3 class="wing-room__title">{room.title}</h3>
          <p class="section-copy">{room.copy}</p>
          <span class="wing-room__cue" aria-hidden="true">&#8594;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block wing-rooms" aria-labelledby="press-related-title">
    <div class="section-header">
      <p class="card-kicker">Related</p>
      <h2 class="section-heading" id="press-related-title">Magazine, submissions, support.</h2>
    </div>
    <div class="section-grid section-grid--three">
      {related.map(room => (
        <a
          class="card wing-room"
          href={room.href}
          target={room.external ? '_blank' : undefined}
          rel={room.external ? 'noopener noreferrer' : undefined}
        >
          <p class="card-kicker">{room.kicker}</p>
          <h3 class="wing-room__title">{room.title}</h3>
          <p class="section-copy">{room.copy}</p>
          <span class="wing-room__cue" aria-hidden="true">&#8594;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block section-block--reading wing-crossing" aria-labelledby="press-crossing-title">
    <article class="card quiet-panel stack">
      <p class="card-kicker">The other side</p>
      <h2 class="section-heading" id="press-crossing-title">There is also a Lab.</h2>
      <p class="section-copy section-copy--large">The same hands build software: agent systems, knowledge graphs, and the field instruments that come out of them. It is where the commissioned work lives.</p>
      <div class="actions">
        <a class="button" href="/lab">Go to the Lab</a>
      </div>
    </article>
  </section>
</Base>
