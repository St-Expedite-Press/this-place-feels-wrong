---
const target = 'https://chat.stexpedite.press/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      var about = new URLSearchParams(window.location.search).get('about');
      var dest = (about || '').toLowerCase() === 'manuscript'
        ? 'https://chat.stexpedite.press/?open=submit'
        : 'https://chat.stexpedite.press/';
      window.location.replace(dest);
    })();
  </script>
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://stexpedite.press/connect" />
  <title>Page moved — St. Expedite Press</title>
</head>
<body>
  <main>
    <h1>Submissions and correspondence now happen in chat.</h1>
    <p>Continue to <a href={target}>chat.stexpedite.press</a>.</p>
  </main>
</body>
</html>
