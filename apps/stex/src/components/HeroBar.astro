---
import siteData from '../data/site.json';

interface Props {
  currentNav?: string;
  minimal?: boolean;
  wing?: 'press' | 'lab';
}

const { currentNav, minimal, wing } = Astro.props;
const { site } = siteData;

const wings = Object.values(site.wings);
const activeWing = wing ? site.wings[wing] : null;
const otherWing = wing ? wings.find((entry) => entry.key !== wing) : null;
const navItems = activeWing ? activeWing.nav : wings.map((entry) => ({ label: entry.label, href: entry.href }));
---
<div class={`hero-bar${minimal ? ' hero-bar--minimal' : ''}`} data-wing={wing}>
  {!minimal && (
    <>
      <a class="hero-bar__wordmark" href="/">
        {activeWing ? site.shortName : site.name}
        {activeWing && (
          <>
            <span class="hero-bar__wing-sep" aria-hidden="true">&#183;</span>
            <span class="hero-bar__wing">{activeWing.label}</span>
          </>
        )}
      </a>

      <nav class="hero-bar__nav" aria-label="Primary">
        {navItems.map(item => (
          <a href={item.href} aria-current={item.href === currentNav ? 'page' : undefined}>{item.label}</a>
        ))}
        {otherWing && (
          <a class="hero-bar__crossing" href={otherWing.href}>{otherWing.label} &#8594;</a>
        )}
      </nav>
    </>
  )}

  <nav class="hero-bar__social" aria-label="Social media">
    {site.social.map(item => (
      <a class="hero-bar__icon" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.name} title={item.title}>
        <Fragment set:html={item.icon} />
      </a>
    ))}
  </nav>

  {!minimal && (
    <details class="hero-bar__menu">
      <summary aria-label="Menu">Menu</summary>
      <nav aria-label="Primary mobile">
        {navItems.map(item => (
          <a href={item.href} aria-current={item.href === currentNav ? 'page' : undefined}>{item.label}</a>
        ))}
        {otherWing && <a class="hero-bar__crossing" href={otherWing.href}>{otherWing.label} &#8594;</a>}
      </nav>
    </details>
  )}
</div>
