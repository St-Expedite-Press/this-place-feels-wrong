---
import siteData from '../data/site.json';

interface Props {
  currentNav?: string;
  minimal?: boolean;
  wing?: 'press' | 'lab';
}

const { currentNav, minimal, wing } = Astro.props;
const { site } = siteData;

const activeWing = wing ? site.wings[wing] : null;
const contextNav = activeWing
  ? activeWing.nav.filter((item) => item.href !== '/press/donate')
  : [];

const globalNav = [
  { label: 'Press', href: '/press' },
  { label: 'Lab', href: '/lab' },
  { label: 'RICE', href: 'https://rice.stexpedite.press/' },
  { label: 'Chat', href: 'https://chat.stexpedite.press/' },
];
---
<div class={`hero-bar${minimal ? ' hero-bar--minimal' : ''}`} data-wing={wing}>
  {!minimal && (
    <>
      <a class="hero-bar__wordmark" href="/">{site.name}</a>

      {activeWing && (
        <nav class="hero-bar__nav" aria-label={`${activeWing.label} navigation`}>
          {contextNav.map(item => (
            <a href={item.href} aria-current={item.href === currentNav ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      )}

      <nav class="hero-bar__global" aria-label="Site navigation">
        {globalNav.map(item => (
          <a href={item.href} aria-current={item.href === currentNav ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </>
  )}

  <nav class="hero-bar__social" aria-label="Social media">
    {site.social.map(item => (
      <a class="hero-bar__icon" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.name} title={item.title}>
        <Fragment set:html={item.icon} />
      </a>
    ))}
  </nav>

  {!minimal && (
    <details class="hero-bar__menu">
      <summary aria-label="Menu">Menu</summary>
      <nav aria-label="Primary mobile">
        <span class="hero-bar__menu-label">Site</span>
        {globalNav.map(item => (
          <a href={item.href} aria-current={item.href === currentNav ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href="/connect">Contact</a>

        {activeWing && (
          <>
            <span class="hero-bar__menu-label">{activeWing.label}</span>
            {contextNav.map(item => (
              <a href={item.href} aria-current={item.href === currentNav ? 'page' : undefined}>{item.label}</a>
            ))}
            {wing === 'press' && <a href="/press/donate">Donate</a>}
          </>
        )}
      </nav>
    </details>
  )}
</div>
