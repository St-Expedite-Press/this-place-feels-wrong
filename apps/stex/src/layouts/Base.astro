---
import Head from '../components/Head.astro';
import HeroBar from '../components/HeroBar.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  subtitle?: string;
  eyebrow?: string;
  introKicker?: string;
  introTitle?: string;
  introText?: string;
  currentNav?: string;
  pageClass?: string;
  brandMode?: 'ritual' | 'editorial' | 'utility' | 'press' | 'lab';
  wing?: 'press' | 'lab';
  styles: string[];
  robots?: string;
}

const {
  title, description, canonical, subtitle, eyebrow,
  introKicker, introTitle, introText, currentNav, pageClass, wing,
  brandMode = 'editorial',
  styles,
  robots,
} = Astro.props;

// Wing identity is the visual contract for all interior Press/Lab pages.
// Older page files may still pass brandMode="editorial"; the wing wins.
const resolvedBrandMode: Props['brandMode'] = wing ?? brandMode;
const wingStyles = wing ? [`assets/css/${wing}-mode.css`] : [];
const allStyles = [...styles, 'assets/css/chat.css', ...wingStyles];
---
<!doctype html>
<html lang="en">
<Head
  title={title}
  description={description}
  canonical={canonical}
  styles={allStyles}
  robots={robots}
/>
<body data-brand-mode={resolvedBrandMode} data-wing={wing}>
  <a class="skip-link" href="#main">Skip to content</a>
  <HeroBar currentNav={currentNav} wing={wing} />
  <div class="texture--grain" aria-hidden="true"></div>
  <main id="main" class={`page${pageClass ? ` ${pageClass}` : ''}`}>
    <section class="page-intro">
      {introKicker && <p class="page-intro__kicker">{introKicker}</p>}
      <h1 class="page-intro__title">{introTitle}</h1>
      {introText && <p class="page-intro__text">{introText}</p>}
    </section>
    <div class="page-content">
      <slot />
    </div>
    <Footer />
  </main>
  <slot name="afterMain" />
  <slot name="scripts" />
  <ChatWidget wing={wing} />
  <script is:inline src='/assets/js/chat-client.js'></script>
  <script is:inline src='/assets/js/chat.js' type='module'></script>
</body>
</html>
