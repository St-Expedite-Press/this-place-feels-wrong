{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stexpedite.press/schemas/chat-request-v1.json",
  "title": "Public chat request",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface", "messages", "turnstileToken"],
  "properties": {
    "surface": { "enum": ["stex", "rice", "openui"] },
    "turnstileToken": { "type": "string", "maxLength": 2048 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
